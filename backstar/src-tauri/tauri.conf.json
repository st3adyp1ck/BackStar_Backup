{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BackStar",
  "version": "2.1.0",
  "identifier": "dev.backstar.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build && cargo clean --release --package backstar-restore && cargo build --release --package backstar-restore"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BackStar",
        "width": 1080,
        "height": 740,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "theme": "Dark",
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": {
      "../target/release/BackStar-Restore.exe": "BackStar-Restore.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGOTk1RUI5RkY0ODRFODEKUldTQlRrai91VjZaTDIzRy9KdituemZFTG82ckQ4NWxMWm9QWHFibytYdWtRcFlJQndKbjBJc04K",
      "endpoints": [
        "https://github.com/st3adyp1ck/BackStar_Backup/releases/latest/download/latest.json"
      ]
    }
  }
}
